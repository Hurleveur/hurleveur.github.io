<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loci — a demo of the mind-palace site</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   LOCI — one site, three rooms.
   The nav swaps body[data-slug] exactly the way Quartz sets it,
   and every visual identity below is keyed off that attribute:
     body[data-slug^="index"]  -> white marble palace
     body[data-slug^="Brain"]  -> space constellation
     body[data-slug^="Books"]  -> warm library
   This is the same CSS you would ship in quartz/styles/custom.scss.
   ============================================================ */

:root {
  --serif: 'Cormorant Garamond', 'Iowan Old Style', Georgia, serif;
  --sans: 'IBM Plex Sans', system-ui, sans-serif;
  /* six branches of the mind (from the notebook drawing) */
  --spiritual: #9b7ede;
  --experiences: #d4a94e;
  --thinking: #6ab7e0;
  --connection: #ef7b6d;
  --feelings: #7fb069;
  --mindset: #4ecdc4;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--serif);
  transition: background-color .8s ease, color .8s ease;
  min-height: 100vh;
}

/* ---------- shared chrome ---------- */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  display: flex; align-items: center; gap: 2rem;
  padding: 1rem 2rem;
  font-family: var(--sans); font-size: .8rem; letter-spacing: .12em;
  text-transform: uppercase;
  transition: background .8s ease, color .8s ease, border-color .8s ease;
}
nav .wordmark {
  font-family: var(--serif); font-size: 1.15rem; font-weight: 600;
  letter-spacing: .28em; text-transform: uppercase; margin-right: auto;
}
nav a {
  color: inherit; text-decoration: none; opacity: .62; cursor: pointer;
  padding: .3rem 0; border-bottom: 1px solid transparent;
  transition: opacity .3s, border-color .3s;
}
nav a:hover, nav a:focus-visible { opacity: 1; }
nav a[aria-current="page"] { opacity: 1; border-bottom-color: currentColor; }
nav a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

.room { display: none; min-height: 100vh; }
.room.active { display: block; animation: roomIn .9s ease both; }
@keyframes roomIn { from { opacity: 0; } to { opacity: 1; } }

.eyebrow {
  font-family: var(--sans); font-size: .7rem; letter-spacing: .34em;
  text-transform: uppercase; opacity: .55;
}

/* the little explainer ribbon at the bottom */
.mechanism {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 50;
  font-family: var(--sans); font-size: .72rem;
  padding: .55rem 2rem; text-align: center;
  transition: background .8s ease, color .8s ease;
}
.mechanism code {
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  padding: .1em .45em; border-radius: 3px;
}

/* ============================================================
   ROOM 1 — THE PALACE  body[data-slug^="index"]
   white marble, oculus light, six doors
   ============================================================ */
body[data-slug^="index"] { background: #f5f3ee; color: #3a372f; }
body[data-slug^="index"] nav { background: rgba(245,243,238,.82); backdrop-filter: blur(8px); color: #3a372f; border-bottom: 1px solid rgba(58,55,47,.12); }
body[data-slug^="index"] .mechanism { background: #e9e5dc; color: #6d675a; }
body[data-slug^="index"] .mechanism code { background: rgba(58,55,47,.09); }

.palace-hero {
  position: relative; min-height: 92vh;
  display: flex; flex-direction: column; justify-content: center; align-items: center;
  text-align: center; padding: 7rem 1.5rem 4rem; overflow: hidden;
}
/* the oculus: one beam of light falling into the hall */
.palace-hero::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 46% 60% at 50% -12%, rgba(255,251,238,.95) 0%, rgba(233,229,218,0) 62%),
    linear-gradient(180deg, rgba(214,226,235,.35) 0%, rgba(245,243,238,0) 30%);
}
.palace-hero > * { position: relative; }
.palace-hero h1 {
  font-size: clamp(2.6rem, 7vw, 5.2rem); font-weight: 500;
  letter-spacing: .16em; text-transform: uppercase; line-height: 1.08;
}
.palace-hero .latin {
  margin-top: 1.1rem; font-style: italic; font-size: clamp(1.05rem, 2vw, 1.35rem);
  color: #7a7362;
}
.palace-hero .colonnade {
  margin: 2.6rem 0 0; display: flex; gap: .9rem; opacity: .5;
}
.palace-hero .colonnade span { width: 1px; height: 52px; background: #3a372f; display: block; }
.palace-hero .colonnade span:nth-child(even) { height: 38px; align-self: flex-end; }

.quote-slab {
  margin: 3rem auto 0; max-width: 34rem; padding: 0 1rem;
  min-height: 5.2rem;
}
.quote-slab blockquote {
  font-size: 1.3rem; font-style: italic; line-height: 1.55; color: #55503f;
  transition: opacity .6s ease;
}
.quote-slab .attribution { margin-top: .7rem; }

/* the six doors */
.doors {
  max-width: 72rem; margin: 0 auto; padding: 4rem 2rem 7rem;
}
.doors h2 {
  text-align: center; font-weight: 500; letter-spacing: .22em;
  text-transform: uppercase; font-size: 1.1rem; margin-bottom: .6rem;
}
.doors .sub { text-align: center; font-style: italic; color: #7a7362; margin-bottom: 3rem; }
.door-row {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1.2rem;
}
.door {
  --tint: #a8843c;
  position: relative; display: block; text-decoration: none; color: inherit;
  aspect-ratio: 5 / 8;
  background: linear-gradient(180deg, #efece4, #e5e1d6);
  border: 1px solid rgba(58,55,47,.14);
  border-radius: 999px 999px 6px 6px; /* arched portal */
  padding: 2.2rem 1rem 1.3rem;
  display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
  text-align: center; cursor: pointer;
  transition: transform .35s ease, box-shadow .35s ease;
  overflow: hidden;
}
.door::before {
  /* glow of the room beyond */
  content: ""; position: absolute; inset: 8% 14% 34% 14%;
  border-radius: 999px 999px 0 0;
  background: radial-gradient(ellipse at 50% 25%, var(--tint) 0%, transparent 75%);
  opacity: .28; transition: opacity .35s ease;
}
.door:hover, .door:focus-visible { transform: translateY(-6px); box-shadow: 0 18px 34px -18px rgba(58,55,47,.35); }
.door:hover::before, .door:focus-visible::before { opacity: .5; }
.door:focus-visible { outline: 2px solid var(--tint); outline-offset: 3px; }
.door .name {
  font-family: var(--sans); font-size: .72rem; letter-spacing: .22em;
  text-transform: uppercase;
}
.door .count { font-style: italic; font-size: .85rem; color: #7a7362; margin-top: .3rem; }

/* ============================================================
   ROOM 2 — THE BRAIN  body[data-slug^="Brain"]
   deep space, living constellation
   ============================================================ */
body[data-slug^="Brain"] { background: #0b0e1f; color: #dfe3f2; }
body[data-slug^="Brain"] nav { background: rgba(11,14,31,.8); backdrop-filter: blur(8px); color: #dfe3f2; border-bottom: 1px solid rgba(223,227,242,.1); }
body[data-slug^="Brain"] .mechanism { background: #101430; color: #8b93b8; }
body[data-slug^="Brain"] .mechanism code { background: rgba(223,227,242,.1); }

.brain-wrap { position: relative; min-height: 100vh; }
#stars, #graph { position: absolute; inset: 0; width: 100%; height: 100%; }
.brain-caption {
  position: absolute; top: 6.2rem; left: 2rem; max-width: 21rem; z-index: 2;
  pointer-events: none;
}
.brain-caption h1 { font-weight: 500; font-size: 2rem; letter-spacing: .06em; }
.brain-caption p { font-family: var(--sans); font-size: .85rem; line-height: 1.6; color: #8b93b8; margin-top: .6rem; }
.brain-legend {
  position: absolute; bottom: 4.2rem; left: 2rem; z-index: 2;
  font-family: var(--sans); font-size: .72rem; letter-spacing: .1em;
  display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; max-width: 30rem;
  color: #8b93b8; pointer-events: none;
}
.brain-legend span::before {
  content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%;
  margin-right: .45em; background: var(--dot);
  box-shadow: 0 0 8px var(--dot);
}
#node-tip {
  position: absolute; z-index: 3; pointer-events: none;
  font-family: var(--sans); font-size: .78rem;
  background: rgba(16,20,48,.92); border: 1px solid rgba(223,227,242,.18);
  color: #dfe3f2; padding: .35rem .7rem; border-radius: 4px;
  transform: translate(-50%, -140%); white-space: nowrap;
  opacity: 0; transition: opacity .15s;
}

/* ============================================================
   ROOM 3 — THE LIBRARY  body[data-slug^="Books"]
   lamplight, wood, spines
   ============================================================ */
body[data-slug^="Books"] { background: #241a11; color: #f0e4d0; }
body[data-slug^="Books"] nav { background: rgba(36,26,17,.85); backdrop-filter: blur(8px); color: #f0e4d0; border-bottom: 1px solid rgba(240,228,208,.12); }
body[data-slug^="Books"] .mechanism { background: #2e2216; color: #b3a184; }
body[data-slug^="Books"] .mechanism code { background: rgba(240,228,208,.1); }

.library {
  max-width: 62rem; margin: 0 auto; padding: 8rem 2rem 7rem;
  background:
    radial-gradient(ellipse 70% 45% at 50% 0%, rgba(201,151,63,.14) 0%, transparent 70%);
}
.library header { text-align: center; margin-bottom: 3.5rem; }
.library h1 { font-weight: 500; font-size: 2.4rem; letter-spacing: .1em; }
.library .sub { font-style: italic; color: #c9ab7c; margin-top: .5rem; }

.shelf {
  display: flex; align-items: flex-end; gap: 6px; justify-content: center;
  padding: 0 1rem 0; flex-wrap: wrap;
}
.spine {
  --cloth: #3f5240;
  writing-mode: vertical-rl;
  min-height: 180px; padding: 1rem .55rem;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(90deg, color-mix(in srgb, var(--cloth) 82%, black), var(--cloth) 40%, color-mix(in srgb, var(--cloth) 70%, black));
  color: #f0e4d0; font-size: .92rem; letter-spacing: .06em;
  border-radius: 3px 3px 2px 2px;
  border: none; cursor: pointer; font-family: var(--serif);
  box-shadow: inset 0 2px 0 rgba(240,228,208,.18), 0 6px 12px -6px rgba(0,0,0,.7);
  transition: transform .3s ease;
}
.spine:nth-child(2n) { min-height: 205px; }
.spine:nth-child(3n) { min-height: 168px; }
.spine:hover, .spine:focus-visible { transform: translateY(-14px); }
.spine:focus-visible { outline: 2px solid #c9973f; outline-offset: 3px; }
.shelf-board {
  height: 10px; margin: 0 auto 3.5rem; max-width: 56rem;
  background: linear-gradient(180deg, #5a3f24, #37271500);
  border-radius: 2px; box-shadow: 0 8px 18px -6px rgba(0,0,0,.8);
}

.reading-table { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.4rem; }
.book-card {
  background: rgba(240,228,208,.05);
  border: 1px solid rgba(240,228,208,.14);
  border-radius: 6px; padding: 1.6rem 1.5rem;
}
.book-card .eyebrow { color: #c9973f; opacity: 1; }
.book-card h3 { font-weight: 600; font-size: 1.25rem; margin: .5rem 0 .6rem; }
.book-card p { font-size: 1rem; line-height: 1.6; color: #d8c6a6; font-style: italic; }
.book-card .lend {
  margin-top: 1rem; font-family: var(--sans); font-size: .72rem;
  letter-spacing: .14em; text-transform: uppercase; color: #c9973f;
}

/* ---------- small screens ---------- */
@media (max-width: 640px) {
  nav { gap: 1.1rem; padding: .9rem 1.1rem; }
  nav .wordmark { letter-spacing: .18em; font-size: 1rem; }
  .brain-caption { left: 1.1rem; right: 1.1rem; }
  .brain-legend { left: 1.1rem; }
  .mechanism { font-size: .62rem; padding: .5rem 1rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
</style>
</head>
<body data-slug="index">

