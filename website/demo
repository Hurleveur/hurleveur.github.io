<p class="mechanism">One site, three identities — this page swaps <code>body[data-slug]</code> on navigation, the exact attribute Quartz sets on every page, so each folder can carry its own world in plain CSS.</p>

<script>
/* ---------- room switching: literally the Quartz mechanism ---------- */
const rooms = ['index', 'Brain', 'Books'];
function go(room) {
  document.body.dataset.slug = room === 'index' ? 'index' : room + '/';
  rooms.forEach(r => {
    document.getElementById('room-' + r).classList.toggle('active', r === room);
  });
  document.querySelectorAll('nav a[data-room]').forEach(a => {
    if (a.dataset.room === room) a.setAttribute('aria-current', 'page');
    else a.removeAttribute('aria-current');
  });
  window.scrollTo({ top: 0 });
  if (room === 'Brain') startGraph();
}
document.querySelectorAll('nav a[data-room]').forEach(a =>
  a.addEventListener('click', () => go(a.dataset.room)));
document.querySelectorAll('[data-room-link]').forEach(a =>
  a.addEventListener('click', e => { e.preventDefault(); go(a.dataset.roomLink); }));

/* ---------- rotating quotes (palace) ---------- */
const quotes = [
  ['How others treat you is not a reflection of who you are. How you treat others is.', 'from the hall of quotes'],
  ['Be a seeker of silence first, for therein lies the truth.', 'from the hall of quotes'],
  ['Dum spiro spero — while I breathe, I hope.', 'from the latin inscriptions'],
  ['Nobody is paying as much attention to you as you are.', 'from the hall of quotes'],
  ['The internet is the largest database. Please don’t pollute it.', 'from guardians of knowledge'],
  ['Solvitur ambulando — it is solved by walking.', 'from the latin inscriptions'],
  ['There isn’t so much to think about really. Just be, feel and do.', 'from the hall of quotes'],
];
let qi = 0;
const qEl = document.getElementById('rotating-quote');
const qSrc = document.getElementById('quote-source');
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (!reduceMotion) {
  setInterval(() => {
    qEl.style.opacity = 0;
    setTimeout(() => {
      qi = (qi + 1) % quotes.length;
      qEl.textContent = quotes[qi][0];
      qSrc.textContent = quotes[qi][1];
      qEl.style.opacity = 1;
    }, 600);
  }, 7000);
}

/* ---------- the constellation (brain) ----------
   A miniature of what 3d-force-graph does with the real vault:
   nodes generated from folder structure, physics layout, hover names. */
const BRANCHES = [
  { name: 'Spiritual',   color: '#9b7ede', notes: ['meditation', 'religion', 'faith', 'letting go', 'ego'] },
  { name: 'Experiences', color: '#d4a94e', notes: ['memory', 'mind palace', 'learning', 'skills', 'travel', 'culture'] },
  { name: 'Thinking',    color: '#6ab7e0', notes: ['reading', 'debating', 'breaking the box', 'forest of knowledge'] },
  { name: 'Connection',  color: '#ef7b6d', notes: ['friends', 'family', 'partner', 'nodding to strangers'] },
  { name: 'Feelings',    color: '#7fb069', notes: ['nature', 'music', 'bansuri', 'sharing'] },
  { name: 'Mindset',     color: '#4ecdc4', notes: ['habits', 'energy', 'goodness', 'coherence with values', 'attention'] },
];

let graphStarted = false;
function startGraph() {
  if (graphStarted) return;
  graphStarted = true;

  const wrap = document.querySelector('.brain-wrap');
  const starsCv = document.getElementById('stars');
  const cv = document.getElementById('graph');
  const tip = document.getElementById('node-tip');
  const ctx = cv.getContext('2d');
  const sctx = starsCv.getContext('2d');
  let W, H, dpr;

  function size() {
    dpr = window.devicePixelRatio || 1;
    W = wrap.clientWidth; H = wrap.clientHeight;
    [cv, starsCv].forEach(c => {
      c.width = W * dpr; c.height = H * dpr;
      c.getContext('2d').setTransform(dpr, 0, 0, dpr, 0, 0);
    });
    paintStars();
  }

  function paintStars() {
    sctx.clearRect(0, 0, W, H);
    for (let i = 0; i < 160; i++) {
      const x = Math.random() * W, y = Math.random() * H;
      const r = Math.random() * 1.1 + .2;
      sctx.globalAlpha = Math.random() * .5 + .1;
      sctx.fillStyle = '#dfe3f2';
      sctx.beginPath(); sctx.arc(x, y, r, 0, 7); sctx.fill();
    }
    sctx.globalAlpha = 1;
  }

  /* build nodes: one hub per branch, leaves around it */
  const nodes = [], links = [];
  BRANCHES.forEach((b, bi) => {
    const angle = (bi / BRANCHES.length) * Math.PI * 2 - Math.PI / 2;
    const hub = {
      label: b.name, color: b.color, r: 9, hub: true,
      x: 0, y: 0, vx: 0, vy: 0,
      ax: Math.cos(angle), ay: Math.sin(angle),
    };
    nodes.push(hub);
    b.notes.forEach(n => {
      const leaf = {
        label: n, color: b.color, r: 3.5 + Math.random() * 2, hub: false,
        x: 0, y: 0, vx: 0, vy: 0, parent: hub,
      };
      nodes.push(leaf);
      links.push([hub, leaf]);
    });
    /* a few cross-branch threads, like real vault wikilinks */
  });
  for (let i = 0; i < 7; i++) {
    const a = nodes[Math.floor(Math.random() * nodes.length)];
    const b = nodes[Math.floor(Math.random() * nodes.length)];
    if (a !== b) links.push([a, b, true]);
  }

  function init() {
    const cx = W / 2, cy = H / 2, R = Math.min(W, H) * .28;
    nodes.forEach(n => {
      if (n.hub) { n.x = cx + n.ax * R; n.y = cy + n.ay * R; }
      else {
        n.x = n.parent.x + (Math.random() - .5) * 120;
        n.y = n.parent.y + (Math.random() - .5) * 120;
      }
    });
  }

  function step() {
    const cx = W / 2, cy = H / 2, R = Math.min(W, H) * .28;
    nodes.forEach(n => {
      /* spring to home position */
      const hx = n.hub ? cx + n.ax * R : n.parent.x + (n.homeDx ??= (Math.random() - .5) * 150);
      const hy = n.hub ? cy + n.ay * R : n.parent.y + (n.homeDy ??= (Math.random() - .5) * 150);
      n.vx += (hx - n.x) * .004; n.vy += (hy - n.y) * .004;
      /* gentle repulsion between leaves */
      nodes.forEach(m => {
        if (m === n) return;
        const dx = n.x - m.x, dy = n.y - m.y, d2 = dx * dx + dy * dy;
        if (d2 < 2200 && d2 > 0) { n.vx += dx / d2 * 3; n.vy += dy / d2 * 3; }
      });
      n.vx *= .92; n.vy *= .92;
      n.x += n.vx; n.y += n.vy;
    });
  }

  let hovered = null;
  cv.addEventListener('pointermove', e => {
    const rect = cv.getBoundingClientRect();
    const x = e.clientX - rect.left, y = e.clientY - rect.top;
    hovered = null;
    for (const n of nodes) {
      if ((n.x - x) ** 2 + (n.y - y) ** 2 < (n.r + 8) ** 2) { hovered = n; break; }
    }
    if (hovered) {
      tip.textContent = hovered.label;
      tip.style.left = hovered.x + 'px';
      tip.style.top = hovered.y + 'px';
      tip.style.opacity = 1;
      cv.style.cursor = 'pointer';
    } else { tip.style.opacity = 0; cv.style.cursor = 'default'; }
  });

  let t = 0;
  function draw() {
    ctx.clearRect(0, 0, W, H);
    t += .008;
    /* links */
    links.forEach(([a, b, cross]) => {
      ctx.strokeStyle = cross ? 'rgba(223,227,242,.10)' : 'rgba(223,227,242,.16)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    });
    /* nodes */
    nodes.forEach((n, i) => {
      const pulse = n.hub ? 1 + Math.sin(t * 2 + i) * .08 : 1;
      const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r * 4 * pulse);
      g.addColorStop(0, n.color);
      g.addColorStop(1, 'transparent');
      ctx.globalAlpha = n.hub ? .35 : .22;
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(n.x, n.y, n.r * 4 * pulse, 0, 7); ctx.fill();
      ctx.globalAlpha = 1;
      ctx.fillStyle = n.color;
      ctx.beginPath(); ctx.arc(n.x, n.y, n.r * pulse, 0, 7); ctx.fill();
      if (n.hub) {
        ctx.font = '600 11px IBM Plex Sans, sans-serif';
        ctx.fillStyle = 'rgba(223,227,242,.85)';
        ctx.textAlign = 'center';
        ctx.fillText(n.label.toUpperCase(), n.x, n.y - n.r - 10);
      }
    });
    if (!reduceMotion) { step(); requestAnimationFrame(draw); }
  }

  size(); init();
  window.addEventListener('resize', () => { size(); });
  if (reduceMotion) { for (let i = 0; i < 300; i++) step(); }
  draw();
}

